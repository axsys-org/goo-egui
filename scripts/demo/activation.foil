- grove_install

+ ios_demo_mount
  + failure
    : reason=iota
  + install
    \ state=namespace
    ^ either[pail namespace]
    = source=path [state.self 'gov 'ios_demo]
    ?> (./some version) state.case(.x source)
      | ./err (pails/t "Missing development template")
    ? (grove_install/instantiate source version
        [state.self 'app 'ios_demo] state)
     > (./ok next) (./ok next)
     > (./err why) (./err (ios_demo_mount/failure why))
